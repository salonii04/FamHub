{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": { 
      "@/*": ["src/*"],
      "@famhub/shared": ["../shared/src/index.ts"]
     },
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}